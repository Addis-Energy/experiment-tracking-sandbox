# Copy to scripts/azure/azure.env (untracked) and fill in. No secrets here:
# the Postgres admin password comes from $PG_ADMIN_PASSWORD or a prompt.
SUBSCRIPTION=<subscription id or name>
RG=rg-experiment-tracker
LOCATION=eastus2
APP=<globally-unique web app name>
PG=<globally-unique postgres server name>
STORAGE=<globally-unique storage account, 3-24 lowercase alphanumerics>
PG_ADMIN_USER=pgadmin
ADMIN_IP=<admin public IP>
HQ_IP=<Hatch.Bio public IP>
ALERT_EMAILS=mat@example.com,michael@example.com
BUDGET_USD=150
# Optional: defaults to the signed-in user's object id
ADMIN_OBJECT_ID=
