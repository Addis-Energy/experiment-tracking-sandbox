# Copy to scripts/azure/azure.env (untracked) and fill in. No secrets here:
# the Postgres admin password comes from $PG_ADMIN_PASSWORD or a prompt.
# Names below are the resources as built in the portal (2026-11-24/25).
SUBSCRIPTION="Azure subscription 1"
# The app and the database are in different resource groups and regions:
# the B1 App Service quota blocked the app in the database's group, so it was
# built in its own group in East US. Both regions are in Virginia (~1 ms apart).
APP_RG=DataApplication-web
APP_LOCATION=eastus
DB_RG=DataApplication
DB_LOCATION=eastus2
APP=addisenergy-lab
# The app's existing plan. provision.sh refuses to run if the app is on a
# different plan, and never creates a plan for an existing app.
PLAN=ASP-DataApplicationweb-9034
PG=addisenergy-db
STORAGE=<globally-unique storage account, 3-24 lowercase alphanumerics>
PG_ADMIN_USER=addisadmin
ADMIN_IP=<admin public IP>
HQ_IP=<Hatch.Bio public IP>
ALERT_EMAILS=<owner 1 email>,<owner 2 email>
BUDGET_USD=120
# Optional: defaults to the signed-in user's object id
ADMIN_OBJECT_ID=
