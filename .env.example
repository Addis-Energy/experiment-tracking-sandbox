# Database
DATABASE_URL=postgresql://experiments_user:experiments_dev_password@postgres:5432/experiments

# Firebase Authentication
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Application
APP_ENV=development
API_PORT=8000
# Serve /docs, /redoc and /openapi.json (dev only; leave unset in production)
ENABLE_API_DOCS=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://localhost:8001

# Sample photo storage: "local" (dev/tests, uses SAMPLE_PHOTOS_DIR) or "blob"
# (Azure production; set on the App Service, never needed locally)
PHOTO_STORAGE=local
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# AZURE_PHOTO_CONTAINER=sample-photos

# Logging
LOG_LEVEL=INFO

# Optional: Backup locations (for production)
BACKUP_DIR=./backups
PUBLIC_COPY_DIR=./public_copies
